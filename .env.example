NODE_ENV=production
PORT=3000
DATA_DIR=/data
PUBLIC_URL=https://your-hostname.example
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
MESSAGE_CONTENT_ENABLED=false
SESSION_SECRET=replace-with-at-least-32-random-characters
# Number of trusted reverse proxy hops; use 1 only for one trusted host proxy.
TRUST_PROXY_HOPS=1
# Optional Twitch live alerts (server-side app credentials only).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
